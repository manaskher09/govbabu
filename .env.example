# Copy to .env.local once you have a Razorpay account. Until these three are
# set, api/create-order.js and api/verify-payment.js run in mock mode — the
# real order/verify/unlock pipeline runs end to end, just without moving
# real money — so the flow is testable today.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Secret used to sign the post-payment unlock token. Set this to a long
# random string for any real deployment — the code falls back to an
# insecure default for local dev only, and warns loudly when it does.
UNLOCK_TOKEN_SECRET=
