# Copy to .env.local (gitignored) and fill in what you have. Every variable
# is optional — the system degrades gracefully without any of them (AI
# extraction and Telegram alerts simply no-op; the admin dashboard runs
# without a token in dev mode).

# Admin dashboard auth. Unset = no auth (fine for localhost only).
MONITOR_ADMIN_TOKEN=

# Level 5 AI-assisted extraction (extract/aiAssist.js). Unset = regex-only.
ANTHROPIC_API_KEY=
MONITOR_AI_MODEL=claude-sonnet-5

# Admin Telegram alerts — fires on every CONFIRMED_CHANGE / NEEDS_HUMAN_REVIEW.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Public Telegram alerts — off by default. Only ever sent AFTER a human
# approves a change (see pipeline/applyApproval.js). Do not enable until
# you actually have a public channel and are ready for it to post there.
TELEGRAM_PUBLIC_ENABLED=false
TELEGRAM_PUBLIC_CHAT_ID=

# Where the SQLite file lives.
MONITOR_DB_PATH=

# Politeness knobs for lib/httpClient.js.
MONITOR_MIN_INTERVAL_MS=3000

# How often the scheduler polls for due sources (pipeline/scheduler.js).
MONITOR_POLL_INTERVAL_MS=60000
